# Public DNS name whose A record points to the Lightsail static IP.
REVISO_HOST=reviso.example.com

# Public Google OAuth web client ID for revisoagent.xyz (and local origin if used).
REVISO_GOOGLE_CLIENT_ID=replace-with-google-web-client-id

# Shared Qwen allowances. Repair attempts count. Saved findings stay readable.
REVISO_QWEN_USER_DAILY_LIMIT=20
REVISO_QWEN_TOTAL_DAILY_LIMIT=200
REVISO_QWEN_MAX_CONCURRENT_USER=1
REVISO_QWEN_MAX_CONCURRENT_TOTAL=4

# Server-side provider credentials. Never use a VITE_* variable.
BITGET_QWEN_API_KEY=
GROQ_API_KEY=
REVISO_LLM_MODEL=qwen/qwen3.8-27b
