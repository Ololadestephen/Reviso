# Public DNS name whose A record points to the Lightsail static IP.
REVISO_HOST=reviso.example.com

# Browser-level credentials for the private hackathon demo.
REVISO_DEMO_USERNAME=reviso
REVISO_DEMO_PASSWORD=replace-with-a-random-password-of-at-least-16-characters

# Server-side provider credentials. Never use a VITE_* variable.
BITGET_QWEN_API_KEY=
GROQ_API_KEY=
REVISO_LLM_MODEL=qwen/qwen3.8-27b
