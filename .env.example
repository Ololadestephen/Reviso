# Placeholders only. Do not put secrets in frontend variables.
REVISO_DB_PATH=data/reviso-v1.sqlite3
# Preferred sponsored Qwen route. Never expose this through VITE_* variables.
BITGET_QWEN_API_KEY=
# Optional Groq. Required for filing follow-up chat (Qwen 3.8 27B) and
# condition drafts (gpt-oss-20b). Extraction and review still prefer Bitget
# when BITGET_QWEN_API_KEY is set.
GROQ_API_KEY=
REVISO_LLM_MODEL=qwen/qwen3.8-27b
REVISO_DRAFT_MODEL=openai/gpt-oss-20b
# Container/public-demo settings. Leave public mode off for local development.
REVISO_PUBLIC_DEMO=0
REVISO_SERVE_WEB=0
REVISO_ALLOWED_HOSTS=
REVISO_ALLOWED_ORIGINS=
# Public Google OAuth web client ID. Required when REVISO_PUBLIC_DEMO=1.
REVISO_GOOGLE_CLIENT_ID=
# local (default), google, or simulated. Public demo cannot use local or simulated.
REVISO_AUTH_MODE=
REVISO_QWEN_USER_DAILY_LIMIT=
REVISO_QWEN_TOTAL_DAILY_LIMIT=
REVISO_QWEN_MAX_CONCURRENT_USER=
REVISO_QWEN_MAX_CONCURRENT_TOTAL=
